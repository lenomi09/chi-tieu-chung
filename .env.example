# Copy file này thành .env (local) hoặc khai báo tương ứng trên Render khi deploy.

# Bắt buộc — mật khẩu admin duy nhất, chỉ bạn biết.
ADMIN_PASSWORD=

# Bắt buộc — chuỗi bí mật để ký cookie đăng nhập. Đặt ngẫu nhiên, càng dài càng tốt.
SESSION_SECRET=

# Chỉ cần khi deploy lên production dùng Turso. Bỏ trống khi chạy local
# (app sẽ tự dùng file SQLite local file:./data.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Đặt là "production" khi deploy để cookie đăng nhập bật cờ Secure (chỉ gửi qua HTTPS).
NODE_ENV=

# Cổng server lắng nghe (tuỳ chọn, mặc định 3456).
PORT=
